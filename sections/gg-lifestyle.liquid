<section class="gg-section gg-lifestyle" id="gg-life-{{ section.id }}">
  <div class="gg-container">
    <div class="gg-head-row">
      <div class="gg-head-row__left">
        <h2 class="gg-h gg-lifestyle__title">{{ section.settings.title | default: 'School Spirit That Goes Where You Go' }}</h2>
      </div>
      <div class="gg-head-row__right">
        <p class="gg-sub gg-lifestyle__sub">{{ section.settings.subtext | default: 'g/g makes collegiate style for beyond game day, with pieces designed to feel just as right in the stands as they do everywhere else.' }}</p>
      </div>
    </div>

    {%- comment -%}
      Slides come from blocks. With no blocks we fall back to the single
      legacy banner so existing installations keep rendering unchanged.
    {%- endcomment -%}
    {%- assign gg_legacy = false -%}
    {%- if section.blocks.size == 0 -%}
      {%- assign gg_legacy = true -%}
      {%- assign gg_count = 1 -%}
    {%- else -%}
      {%- assign gg_count = section.blocks.size -%}
    {%- endif -%}

    {%- comment -%}
      Image priority: the selected section "Banner image" always wins, then
      the slide's own image, then the static theme asset as a last resort.
    {%- endcomment -%}
    {%- if section.settings.image != blank -%}
      {%- assign gg_selected_image = section.settings.image | image_url: width: 2000 -%}
    {%- else -%}
      {%- assign gg_selected_image = 'gg-lifestyle.png' | asset_url -%}
    {%- endif -%}
  </div>

  {%- comment -%}
    Banner sits outside .gg-container so it can be edge to edge on mobile.
    Desktop keeps the container gutters via the side margins in gg.css.
  {%- endcomment -%}
  <div
    class="gg-lifestyle__banner"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.speed | times: 1000 }}"
  >
    {%- for i in (1..gg_count) -%}
        {%- assign gg_idx = forloop.index0 -%}
        {%- assign gg_first = false -%}
        {%- if forloop.first -%}{%- assign gg_first = true -%}{%- endif -%}

        {%- if gg_legacy -%}
          {%- assign gg_image = gg_selected_image -%}
          {%- assign gg_heading = section.settings.banner_heading -%}
          {%- assign gg_label = section.settings.cta_label | default: 'Get the look' -%}
          {%- assign gg_link = section.settings.cta_link | default: routes.collections_url -%}
        {%- else -%}
          {%- assign gg_block = section.blocks[gg_idx] -%}
          {%- if section.settings.image != blank -%}
            {%- assign gg_image = gg_selected_image -%}
          {%- elsif gg_block.settings.image != blank -%}
            {%- assign gg_image = gg_block.settings.image | image_url: width: 2000 -%}
          {%- else -%}
            {%- assign gg_image = gg_selected_image -%}
          {%- endif -%}
          {%- assign gg_heading = gg_block.settings.heading -%}
          {%- assign gg_label = gg_block.settings.cta_label | default: 'Get the look' -%}
          {%- assign gg_link = gg_block.settings.cta_link | default: routes.collections_url -%}
        {%- endif -%}

        <div
          class="gg-lifestyle__slide{% if gg_first %} is-active{% endif %}"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ gg_count }}"
        >
          <div class="gg-lifestyle__bg" style="background-image:url('{{ gg_image }}')"></div>
          <div class="gg-lifestyle__tint"></div>
          <div class="gg-lifestyle__foot">
            {%- if gg_heading != blank -%}
              <h3 class="gg-lifestyle__heading">{{ gg_heading }}</h3>
            {%- endif -%}

            {%- if gg_count > 1 -%}
              <div class="gg-lifestyle__dots" role="group" aria-label="Choose slide">
                {%- for j in (1..gg_count) -%}
                  {%- assign gg_dot_active = false -%}
                  {%- if forloop.index == i -%}{%- assign gg_dot_active = true -%}{%- endif -%}
                  <button
                    type="button"
                    class="gg-lifestyle__dot{% if gg_dot_active %} is-active{% endif %}"
                    data-index="{{ forloop.index0 }}"
                    aria-current="{{ gg_dot_active }}"
                    aria-label="Go to slide {{ forloop.index }}"
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if gg_label != blank -%}
              <a class="gg-btn gg-btn--primary gg-lifestyle__cta" href="{{ gg_link }}"{% render 'gg-link-attrs', url: gg_link %}>
                {{ gg_label }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    var banner = document.getElementById('gg-life-{{ section.id }}');
    if (!banner) return;
    var root = banner.querySelector('.gg-lifestyle__banner');
    if (!root || root.dataset.ggReady === 'true') return;
    root.dataset.ggReady = 'true';

    var slides = Array.prototype.slice.call(root.querySelectorAll('.gg-lifestyle__slide'));
    if (slides.length < 2) return;

    var FOCUSABLE = 'a[href], button, [tabindex]:not([tabindex="-1"])';
    var autoplay = root.dataset.autoplay === 'true';
    var speed = parseInt(root.dataset.speed, 10) || 5000;
    var reduceMotion = window.matchMedia
      && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var current = 0;
    var timer = null;
    var paused = false;

    function render() {
      slides.forEach(function (slide, n) {
        var on = n === current;
        slide.classList.toggle('is-active', on);
        slide.setAttribute('aria-hidden', String(!on));
        Array.prototype.forEach.call(slide.querySelectorAll(FOCUSABLE), function (el) {
          if (on) {
            el.removeAttribute('tabindex');
          } else {
            el.setAttribute('tabindex', '-1');
          }
        });
        Array.prototype.forEach.call(slide.querySelectorAll('.gg-lifestyle__dot'), function (dot, j) {
          var dotOn = j === current;
          dot.classList.toggle('is-active', dotOn);
          dot.setAttribute('aria-current', String(dotOn));
        });
      });
    }

    function go(n) {
      current = (n + slides.length) % slides.length;
      render();
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function start() {
      stop();
      if (!autoplay || reduceMotion || paused || document.hidden) return;
      timer = setInterval(function () { go(current + 1); }, speed);
    }

    root.addEventListener('click', function (event) {
      var dot = event.target.closest('.gg-lifestyle__dot');
      if (!dot || !root.contains(dot)) return;
      go(parseInt(dot.dataset.index, 10));
      start();
    });

    // Hold the carousel still while the user is on it.
    function hold() { paused = true; start(); }
    function release() { paused = false; start(); }

    root.addEventListener('mouseenter', hold);
    root.addEventListener('mouseleave', release);
    root.addEventListener('focusin', hold);
    root.addEventListener('focusout', release);
    document.addEventListener('visibilitychange', start);

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) start();
          else stop();
        });
      }, { threshold: 0.25 });
      io.observe(root);
    }

    render();
    start();
  })();
</script>

{% schema %}
{
  "name": "G/G Lifestyle Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image", "info": "Shown on the banner whenever selected (overrides slide images). Leave empty to use each slide's image below." },
    { "type": "text", "id": "title", "label": "Title", "default": "School Spirit That Goes Where You Go" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "g/g makes collegiate style for beyond game day, with pieces designed to feel just as right in the stands as they do everywhere else." },
    { "type": "text", "id": "banner_heading", "label": "Banner heading" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Get the look" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Carousel" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "speed", "label": "Autoplay speed (sec)", "min": 2, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "cta_label", "label": "Button", "default": "Get the look" },
        { "type": "url", "id": "cta_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "G/G Lifestyle Banner",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
<section class="gg-section gg-arrivals">
  <div class="gg-container">
    <div class="gg-head-row">
      <div class="gg-head-row__left">
        <span class="gg-eyebrow">{{ section.settings.eyebrow | default: 'New Arrivals' }}</span>
        <h2 class="gg-h" style="font-size:clamp(36px,4.4vw,64px);">{{ section.settings.title | default: 'JUST LANDED' }}</h2>
        <p class="gg-sub" style="font-size:20px;margin-top:10px;">{{ section.settings.subtext | default: 'New styles. Same school pride.' }}</p>
      </div>
      <div class="gg-head-row__right">
        <a class="gg-btn gg-btn--primary" href="{{ section.settings.all_link | default: routes.collections_url }}">
          {{ section.settings.all_label | default: 'View All' }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
      </div>
    </div>

    <div class="gg-grid gg-grid--3">
      {%- for block in section.blocks -%}
        <a class="gg-card gg-card--tall" href="{{ block.settings.link | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          <div class="gg-card__media">
            <img src="{{ block.settings.image_asset | default: 'gg-p-gaby.png' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="345" height="460">
            <div class="gg-card__top">
              <span class="gg-card__logo">
                <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="15" fill="rgba(255,255,255,0.85)"/><path d="M16 6 5 24h6l5-10 5 10h6L16 6Z" fill="#0C3054"/></svg>
              </span>
              <svg class="gg-card__heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 20s-7.5-4.6-9.3-9A5.4 5.4 0 0 1 12 5.8 5.4 5.4 0 0 1 21.3 11c-1.8 4.4-9.3 9-9.3 9Z"/></svg>
            </div>
          </div>
          <div class="gg-card__body">
            <h3 class="gg-card__title">{{ block.settings.title }}</h3>
            <div class="gg-card__price">{{ block.settings.price }}</div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "G/G New Arrivals",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Arrivals" },
    { "type": "text", "id": "title", "label": "Title", "default": "JUST LANDED" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "New styles. Same school pride." },
    { "type": "text", "id": "all_label", "label": "All label", "default": "View All" },
    { "type": "url", "id": "all_link", "label": "All link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "image_asset", "label": "Default image", "options": [
          { "value": "gg-p-miranda.png", "label": "Miranda oversize fleece crew" },
          { "value": "gg-p-willow.png", "label": "Willow camo sherpa hoodie" },
          { "value": "gg-p-wallace.png", "label": "Wallace camo field jacket" },
          { "value": "gg-p-winona.png", "label": "Winona camo sport dress" },
          { "value": "gg-p-shea.png", "label": "Shea jacquard cardigan" },
          { "value": "gg-p-sylvie.png", "label": "Sylvie name sleeve sweater" },
          { "value": "gg-p-georgie.png", "label": "Georgie crystal denim jacket" },
          { "value": "gg-p-gaby.png", "label": "Gaby contrast sherpa jacket" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "PRODUCT" },
        { "type": "text", "id": "price", "label": "Price", "default": "$80.00" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "G/G New Arrivals",
      "blocks": [
        { "type": "product", "settings": { "image_asset": "gg-p-miranda.png", "title": "MIRANDA OVERSIZED FLEECE CREW", "price": "$62.00" } },
        { "type": "product", "settings": { "image_asset": "gg-p-willow.png", "title": "WILLOW FASHION CAMO SHERPA HOODIE", "price": "$78.00" } },
        { "type": "product", "settings": { "image_asset": "gg-p-wallace.png", "title": "WALLACE CLASSIC CAMO FIELD JACKET", "price": "$113.00" } },
        { "type": "product", "settings": { "image_asset": "gg-p-winona.png", "title": "WINONA CLASSIC CAMO SPORT DRESS", "price": "$80.00" } },
        { "type": "product", "settings": { "image_asset": "gg-p-shea.png", "title": "SHEA TEAM JACQUARD CARDIGAN", "price": "$136.00" } },
        { "type": "product", "settings": { "image_asset": "gg-p-gaby.png", "title": "GABY CONTRAST SHERPA JACKET", "price": "$134.00" } }
      ]
    }
  ]
}
{% endschema %}
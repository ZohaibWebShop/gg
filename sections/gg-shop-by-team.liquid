<section class="gg-section gg-shopteam">
  {%- assign logo_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'team' -%}
      {%- assign logo_count = logo_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign team_count = logo_count -%}
  <div class="gg-container">
    <div class="gg-head-row">
      <div class="gg-head-row__col gg-head-row__col--1">
        <span class="gg-eyebrow">{{ section.settings.eyebrow | default: 'Shop by Team' }}</span>
        <h2 class="gg-h--serif" style="font-size:clamp(34px,3.6vw,56px);">{{ section.settings.title | default: 'Who Are You Repping?' }}</h2>
      </div>
      <div class="gg-head-row__col gg-head-row__col--2">
        <p class="gg-sub">{{ section.settings.subtext | default: 'Your team is more than a logo. It’s part of your story.' }}</p>
      </div>
    </div>

    <div class="gg-team-logos">
      <button type="button" class="gg-team-logos__arrow" aria-label="Previous teams">
        <svg width="19" height="40" viewBox="0 0 19 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.58579 21.4142C0.804738 20.6332 0.804738 19.3668 1.58579 18.5858L14.3137 5.85786C15.0948 5.07682 16.3611 5.07682 17.1421 5.85786C17.9232 6.63891 17.9232 7.90524 17.1421 8.68629L5.82843 20L17.1421 31.3137C17.9232 32.0948 17.9232 33.3611 17.1421 34.1421C16.3611 34.9232 15.0948 34.9232 14.3137 34.1421L1.58579 21.4142ZM4 20V22H3V20V18H4V20Z" fill="currentColor"/></svg>
      </button>
      <div class="gg-team-logos__track">
        {%- if logo_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'team' -%}
              {%- if block.settings.image != blank -%}
                {%- assign team_logo = block.settings.image | image_url: width: 300 -%}
              {%- elsif block.settings.collection != blank and block.settings.collection.featured_image -%}
                {%- assign team_logo = block.settings.collection.featured_image | image_url: width: 300 -%}
              {%- else -%}
                {%- assign team_logo = block.settings.image_asset | default: 'gg-team-1.png' | asset_url -%}
              {%- endif -%}
              {%- if block.settings.collection != blank -%}
                {%- assign team_href = block.settings.collection.url -%}
                {%- assign team_label = block.settings.collection.title -%}
                {%- assign team_filter = block.settings.collection.handle -%}
              {%- else -%}
                {%- assign team_href = block.settings.link | default: routes.collections_url -%}
                {%- assign team_label = 'Team logo' -%}
                {%- assign team_filter = '__none__' | append: block.id -%}
              {%- endif -%}
              <a class="gg-team-logos__item" href="{{ team_href }}"{% render 'gg-link-attrs', url: team_href %} data-gg-team-filter="{{ team_filter }}" aria-label="{{ team_label | escape }}" {{ block.shopify_attributes }}>
                <img src="{{ team_logo }}" alt="{{ team_label | escape }}" loading="lazy" width="114" height="64">
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <div class="gg-team-logos__item">
              <img src="{{ 'gg-team-' | append: i | append: '.png' | asset_url }}" alt="Team logo {{ i }}" loading="lazy" width="114" height="64">
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <button type="button" class="gg-team-logos__arrow" aria-label="Next teams">
        <svg width="19" height="40" viewBox="0 0 19 40" fill="none" xmlns="http://www.w3.org/2000/svg" style="transform:scale(-1,1);"><path d="M1.58579 21.4142C0.804738 20.6332 0.804738 19.3668 1.58579 18.5858L14.3137 5.85786C15.0948 5.07682 16.3611 5.07682 17.1421 5.85786C17.9232 6.63891 17.9232 7.90524 17.1421 8.68629L5.82843 20L17.1421 31.3137C17.9232 32.0948 17.9232 33.3611 17.1421 34.1421C16.3611 34.9232 15.0948 34.9232 14.3137 34.1421L1.58579 21.4142ZM4 20V22H3V20V18H4V20Z" fill="currentColor"/></svg>
      </button>
    </div>

    <div class="gg-teams-meta">
      <div class="gg-teams-meta__inner">
        <p class="gg-teams-meta__total">
          <span class="gg-teams-meta__total-label">{{ section.settings.teams_total_label | default: 'Total Teams:' }}</span>
          <span class="gg-teams-meta__total-count">{{ team_count }}</span>
        </p>
        <div class="gg-teams-meta__dots">
          {%- assign dot_count = logo_count | default: 6 -%}
          {%- if dot_count > 6 -%}{%- assign dot_count = 6 -%}{%- endif -%}
          {%- if dot_count < 1 -%}{%- assign dot_count = 6 -%}{%- endif -%}
          {%- for i in (1..dot_count) -%}
            <span{% if forloop.first %} class="gg-dot--on"{% endif %}></span>
          {%- endfor -%}
        </div>
      <a class="gg-teams-meta__link" href="{{ section.settings.team_link | default: 'javascript:void(0)' }}"{% render 'gg-link-attrs', url: section.settings.team_link %} data-gg-team-showall>
        <span>{{ section.settings.show_all | default: 'Show all teams' }}</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g clip-path="url(#clip0_29_83)"><path d="M15.6934 7.50012L10.2612 12.9323L8.97899 11.65L12.1906 8.43847L1.1876 8.38101L1.22032 6.58652L12.3011 6.64566L8.93528 3.27983L10.2042 2.01094L15.6934 7.50012Z" fill="#F26728"/></g><defs><clipPath id="clip0_29_83"><rect width="16" height="16" fill="white" transform="matrix(-1 0 0 1 16 0)"/></clipPath></defs></svg>
      </a>
      </div>
    </div>
    {%- assign grid_collection = section.settings.products_collection -%}
    {%- assign grid_limit = section.settings.products_to_show | default: 4 | plus: 0 -%}
    {%- assign grid_cap = 100 -%}
    {%- assign gg_more_count = 0 -%}
    {%- assign gg_first_block_product = blank -%}
    {%- assign total_rendered = 0 -%}
    {%- assign rendered_ids = ',' -%}
    <div class="gg-grid gg-grid--4 gg-shopteam__grid" data-gg-load-grid>
      {%- if grid_collection != blank and grid_collection.products.size > 0 -%}
        {%- for product in grid_collection.products limit: grid_cap -%}
          {%- assign pid_check = ',' | append: product.id | append: ',' -%}
          {%- unless rendered_ids contains pid_check -%}
            {%- assign rendered_ids = rendered_ids | append: product.id | append: ',' -%}
            {%- assign total_rendered = total_rendered | plus: 1 -%}
            {%- if total_rendered > grid_limit -%}
              {%- assign gg_more_count = gg_more_count | plus: 1 -%}
            {%- endif -%}
            {%- assign gg_card_amz = blank -%}
            {%- if settings.amazon_links_enabled != false -%}
              {%- capture gg_card_amz -%}{%- render 'gg-amazon-url', product: product -%}{%- endcapture -%}
              {%- assign gg_card_amz = gg_card_amz | strip -%}
            {%- endif -%}
            {%- capture card_team_tags -%}
              {{ grid_collection.handle }}
              {%- for c in product.collections %} {{ c.handle }}{%- endfor -%}
            {%- endcapture -%}
            <a class="gg-card gg-card--tall" href="{{ gg_card_amz | default: product.url }}"{% if gg_card_amz != blank %} target="_blank" rel="noopener noreferrer"{% endif %}{% if total_rendered > grid_limit %} data-gg-more hidden{% endif %} data-gg-team-tags="{{ card_team_tags | strip }}">
              <div class="gg-card__media">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="403" height="538">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'gg-card__ph' }}
                {%- endif -%}
                <div class="gg-card__top">
                  <span class="gg-card__logo">
                    {% render 'gg-sports-logo', product: product %}
                  </span>
                  <svg class="gg-card__heart" width="29" height="29" viewBox="0 0 29 29" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M23.5882 5.84989C22.3478 4.60635 20.7037 3.84736 18.9527 3.71003C17.2018 3.5727 15.4594 4.06608 14.0404 5.10104C12.5517 3.99373 10.6987 3.49163 8.85456 3.69584C7.01045 3.90004 5.31221 4.7954 4.10181 6.20159C2.89141 7.60779 2.25878 9.42037 2.33129 11.2743C2.40381 13.1283 3.1761 14.8859 4.49264 16.1933L11.7588 23.4711C12.3672 24.0699 13.1867 24.4055 14.0404 24.4055C14.8941 24.4055 15.7136 24.0699 16.322 23.4711L23.5882 16.1933C24.9543 14.8188 25.7211 12.9595 25.7211 11.0216C25.7211 9.08363 24.9543 7.2244 23.5882 5.84989ZM21.9384 14.5786L14.6722 21.8447C14.5896 21.9282 14.4911 21.9945 14.3827 22.0397C14.2742 22.0849 14.1579 22.1082 14.0404 22.1082C13.9229 22.1082 13.8066 22.0849 13.6981 22.0397C13.5897 21.9945 13.4912 21.9282 13.4086 21.8447L6.14244 14.5435C5.22482 13.6055 4.71099 12.3455 4.71099 11.0333C4.71099 9.7211 5.22482 8.46107 6.14244 7.52308C7.07751 6.59989 8.33862 6.08223 9.65264 6.08223C10.9667 6.08223 12.2278 6.59989 13.1628 7.52308C13.2716 7.63275 13.401 7.7198 13.5436 7.7792C13.6862 7.8386 13.8391 7.86919 13.9936 7.86919C14.1481 7.86919 14.301 7.8386 14.4436 7.7792C14.5862 7.7198 14.7156 7.63275 14.8243 7.52308C15.7594 6.59989 17.0205 6.08223 18.3345 6.08223C19.6486 6.08223 20.9097 6.59989 21.8448 7.52308C22.775 8.44878 23.3057 9.70197 23.3232 11.0142C23.3407 12.3264 22.8436 13.5933 21.9384 14.5435V14.5786Z" fill="#0C3054"/></svg>
                </div>
              </div>
              <div class="gg-card__body">
                <h3 class="gg-card__title">{{ product.title }}</h3>
                {%- if product.price_varies == false -%}
                  <div class="gg-card__price">{{ product.price | money }}</div>
                {%- elsif product.price_varies -%}
                  <div class="gg-card__price">{{ product.price_min | money }} – {{ product.price_max | money }}</div>
                {%- endif -%}
              </div>
            </a>
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%}
        Render products strictly from collections selected on Team logo blocks
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'team' and block.settings.collection != blank -%}
          {%- assign team_coll = block.settings.collection -%}
          {%- for product in team_coll.products limit: grid_cap -%}
            {%- assign pid_check = ',' | append: product.id | append: ',' -%}
            {%- unless rendered_ids contains pid_check -%}
              {%- assign rendered_ids = rendered_ids | append: product.id | append: ',' -%}
              {%- assign total_rendered = total_rendered | plus: 1 -%}
              {%- if total_rendered > grid_limit -%}
                {%- assign gg_more_count = gg_more_count | plus: 1 -%}
              {%- endif -%}
              {%- assign gg_card_amz = blank -%}
              {%- if settings.amazon_links_enabled != false -%}
                {%- capture gg_card_amz -%}{%- render 'gg-amazon-url', product: product -%}{%- endcapture -%}
                {%- assign gg_card_amz = gg_card_amz | strip -%}
              {%- endif -%}
              {%- capture card_team_tags -%}
                {{ team_coll.handle }}
                {%- for c in product.collections %} {{ c.handle }}{%- endfor -%}
              {%- endcapture -%}
              <a class="gg-card gg-card--tall" href="{{ gg_card_amz | default: product.url }}"{% if gg_card_amz != blank %} target="_blank" rel="noopener noreferrer"{% endif %}{% if total_rendered > grid_limit %} data-gg-more hidden{% endif %} data-gg-team-tags="{{ card_team_tags | strip }}">
                <div class="gg-card__media">
                  {%- if product.featured_image -%}
                    <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="403" height="538">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'gg-card__ph' }}
                  {%- endif -%}
                  <div class="gg-card__top">
                    <span class="gg-card__logo">
                      {% render 'gg-sports-logo', product: product %}
                    </span>
                    <svg class="gg-card__heart" width="29" height="29" viewBox="0 0 29 29" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M23.5882 5.84989C22.3478 4.60635 20.7037 3.84736 18.9527 3.71003C17.2018 3.5727 15.4594 4.06608 14.0404 5.10104C12.5517 3.99373 10.6987 3.49163 8.85456 3.69584C7.01045 3.90004 5.31221 4.7954 4.10181 6.20159C2.89141 7.60779 2.25878 9.42037 2.33129 11.2743C2.40381 13.1283 3.1761 14.8859 4.49264 16.1933L11.7588 23.4711C12.3672 24.0699 13.1867 24.4055 14.0404 24.4055C14.8941 24.4055 15.7136 24.0699 16.322 23.4711L23.5882 16.1933C24.9543 14.8188 25.7211 12.9595 25.7211 11.0216C25.7211 9.08363 24.9543 7.2244 23.5882 5.84989ZM21.9384 14.5786L14.6722 21.8447C14.5896 21.9282 14.4911 21.9945 14.3827 22.0397C14.2742 22.0849 14.1579 22.1082 14.0404 22.1082C13.9229 22.1082 13.8066 22.0849 13.6981 22.0397C13.5897 21.9945 13.4912 21.9282 13.4086 21.8447L6.14244 14.5435C5.22482 13.6055 4.71099 12.3455 4.71099 11.0333C4.71099 9.7211 5.22482 8.46107 6.14244 7.52308C7.07751 6.59989 8.33862 6.08223 9.65264 6.08223C10.9667 6.08223 12.2278 6.59989 13.1628 7.52308C13.2716 7.63275 13.401 7.7198 13.5436 7.7792C13.6862 7.8386 13.8391 7.86919 13.9936 7.86919C14.1481 7.86919 14.301 7.8386 14.4436 7.7792C14.5862 7.7198 14.7156 7.63275 14.8243 7.52308C15.7594 6.59989 17.0205 6.08223 18.3345 6.08223C19.6486 6.08223 20.9097 6.59989 21.8448 7.52308C22.775 8.44878 23.3057 9.70197 23.3232 11.0142C23.3407 12.3264 22.8436 13.5933 21.9384 14.5435V14.5786Z" fill="#0C3054"/></svg>
                  </div>
                </div>
                <div class="gg-card__body">
                  <h3 class="gg-card__title">{{ product.title }}</h3>
                  {%- if product.price_varies == false -%}
                    <div class="gg-card__price">{{ product.price | money }}</div>
                  {%- elsif product.price_varies -%}
                    <div class="gg-card__price">{{ product.price_min | money }} – {{ product.price_max | money }}</div>
                  {%- endif -%}
                </div>
              </a>
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%}
        Render explicitly selected Product blocks
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' and block.settings.product != blank -%}
          {%- assign product = block.settings.product -%}
          {%- if gg_first_block_product == blank -%}
            {%- assign gg_first_block_product = product -%}
          {%- endif -%}
          {%- assign pid_check = ',' | append: product.id | append: ',' -%}
          {%- unless rendered_ids contains pid_check -%}
            {%- assign rendered_ids = rendered_ids | append: product.id | append: ',' -%}
            {%- assign total_rendered = total_rendered | plus: 1 -%}
            {%- if total_rendered > grid_limit -%}
              {%- assign gg_more_count = gg_more_count | plus: 1 -%}
            {%- endif -%}
            {%- assign gg_card_amz = blank -%}
            {%- if settings.amazon_links_enabled != false -%}
              {%- capture gg_card_amz -%}{%- render 'gg-amazon-url', product: product -%}{%- endcapture -%}
              {%- assign gg_card_amz = gg_card_amz | strip -%}
            {%- endif -%}
            {%- capture card_team_tags -%}
              {%- for c in product.collections %}{{ c.handle }} {% endfor -%}
            {%- endcapture -%}
            <a class="gg-card gg-card--tall" href="{{ gg_card_amz | default: product.url }}"{% if gg_card_amz != blank %} target="_blank" rel="noopener noreferrer"{% endif %}{% if total_rendered > grid_limit %} data-gg-more hidden{% endif %} {{ block.shopify_attributes }} data-gg-team-tags="{{ card_team_tags | strip }}">
              <div class="gg-card__media">
                {%- if product.featured_image != blank -%}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="403" height="538">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'gg-card__ph' }}
                {%- endif -%}
                <div class="gg-card__top">
                  <span class="gg-card__logo">
                    {% render 'gg-sports-logo', product: product %}
                  </span>
                  <svg class="gg-card__heart" width="29" height="29" viewBox="0 0 29 29" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M23.5882 5.84989C22.3478 4.60635 20.7037 3.84736 18.9527 3.71003C17.2018 3.5727 15.4594 4.06608 14.0404 5.10104C12.5517 3.99373 10.6987 3.49163 8.85456 3.69584C7.01045 3.90004 5.31221 4.7954 4.10181 6.20159C2.89141 7.60779 2.25878 9.42037 2.33129 11.2743C2.40381 13.1283 3.1761 14.8859 4.49264 16.1933L11.7588 23.4711C12.3672 24.0699 13.1867 24.4055 14.0404 24.4055C14.8941 24.4055 15.7136 24.0699 16.322 23.4711L23.5882 16.1933C24.9543 14.8188 25.7211 12.9595 25.7211 11.0216C25.7211 9.08363 24.9543 7.2244 23.5882 5.84989ZM21.9384 14.5786L14.6722 21.8447C14.5896 21.9282 14.4911 21.9945 14.3827 22.0397C14.2742 22.0849 14.1579 22.1082 14.0404 22.1082C13.9229 22.1082 13.8066 22.0849 13.6981 22.0397C13.5897 21.9945 13.4912 21.9282 13.4086 21.8447L6.14244 14.5435C5.22482 13.6055 4.71099 12.3455 4.71099 11.0333C4.71099 9.7211 5.22482 8.46107 6.14244 7.52308C7.07751 6.59989 8.33862 6.08223 9.65264 6.08223C10.9667 6.08223 12.2278 6.59989 13.1628 7.52308C13.2716 7.63275 13.401 7.7198 13.5436 7.7792C13.6862 7.8386 13.8391 7.86919 13.9936 7.86919C14.1481 7.86919 14.301 7.8386 14.4436 7.7792C14.5862 7.7198 14.7156 7.63275 14.8243 7.52308C15.7594 6.59989 17.0205 6.08223 18.3345 6.08223C19.6486 6.08223 20.9097 6.59989 21.8448 7.52308C22.775 8.44878 23.3057 9.70197 23.3232 11.0142C23.3407 12.3264 22.8436 13.5933 21.9384 14.5435V14.5786Z" fill="#0C3054"/></svg>
                </div>
              </div>
              <div class="gg-card__body">
                <h3 class="gg-card__title">{{ product.title }}</h3>
                {%- if product.price_varies == false -%}
                  <div class="gg-card__price">{{ product.price | money }}</div>
                {%- elsif product.price_varies -%}
                  <div class="gg-card__price">{{ product.price_min | money }} – {{ product.price_max | money }}</div>
                {%- endif -%}
              </div>
            </a>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <p class="gg-shopteam__empty" data-gg-empty hidden>{{ section.settings.no_products | default: 'No products found for this team.' }}</p>

    {%- assign gg_cta_amz = section.settings.load_amz -%}
    {%- if gg_cta_amz == blank and settings.amazon_links_enabled != false -%}
      {%- capture gg_cta_amz -%}{%- render 'gg-amazon-url', collection: grid_collection -%}{%- endcapture -%}
      {%- assign gg_cta_amz = gg_cta_amz | strip -%}
    {%- endif -%}
    {%- if gg_cta_amz == blank and settings.amazon_links_enabled != false -%}
      {%- capture gg_cta_amz -%}{%- render 'gg-amazon-url', product: gg_first_block_product -%}{%- endcapture -%}
      {%- assign gg_cta_amz = gg_cta_amz | strip -%}
    {%- endif -%}
    {%- assign gg_cta_href = gg_cta_amz | default: section.settings.load_link | default: routes.collections_url -%}

    <div class="gg-center gg-center--cta">
      {%- if gg_more_count > 0 and section.settings.load_btn != blank -%}
        <button type="button" class="gg-btn gg-btn--primary gg-btn--serif"
          data-gg-load-more
          data-gg-batch="{{ grid_limit }}"
          data-gg-done-href="{{ gg_cta_href }}"
          data-gg-done-label="{{ section.settings.load_done_btn | escape }}">
          {{ section.settings.load_btn }}
        </button>
      {%- elsif section.settings.load_done_btn != blank -%}
        <a class="gg-btn gg-btn--primary gg-btn--serif" href="{{ gg_cta_href }}"{% if gg_cta_amz != blank %} target="_blank" rel="noopener noreferrer"{% endif %}>
          {{ section.settings.load_done_btn }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "G/G Shop By Team",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by Team" },
    { "type": "text", "id": "title", "label": "Title", "default": "Who Are You Repping?" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Your team is more than a logo. It's part of your story." },
    { "type": "text", "id": "team_btn", "label": "Team button", "default": "Select Your Team" },
    { "type": "collection_list", "id": "collections", "label": "Teams (collections)" },
    { "type": "collection", "id": "products_collection", "label": "Collection for product grid", "info": "Products from this collection fill the grid below. Leave empty to use the Team collections or Product blocks instead." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "no_products", "label": "Empty state text", "default": "No products found for this team." },
    { "type": "url", "id": "team_link", "label": "Team link" },

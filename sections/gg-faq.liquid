<section class="gg-section gg-faq">
  <div class="gg-container">
    <div class="gg-head-row">
      <div class="gg-head-row__left">
        {%- if section.settings.eyebrow != blank -%}
          <span class="gg-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- assign faq_heading_tag = section.settings.heading_tag | default: 'h2' -%}
        <{{ faq_heading_tag }} class="gg-h--serif gg-faq__title" style="font-size:clamp(34px,3.6vw,56px);">
          {{ section.settings.title | default: 'FAQs' }}
        </{{ faq_heading_tag }}>
      </div>
    </div>

    <div class="gg-faq__list">
      {%- for block in section.blocks -%}
        <details class="gg-faq__item" {{ block.shopify_attributes }}>
          <summary class="gg-faq__question">
            <span class="gg-faq__question-text">{{ block.settings.question }}</span>
            <span class="gg-faq__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 3.5V16.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                <path d="M3.5 10H16.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </span>
          </summary>
          <div class="gg-faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "G/G FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Title", "default": "FAQs" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question goes here?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer goes here.</p>" }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "G/G FAQ",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}

<section class="gg-cta" style="--gg-cta-bg:url('{{ cta_image }}');">
  {%- if section.settings.image != blank -%}
    {%- assign cta_image = section.settings.image | image_url: width: 2000 -%}
  {%- else -%}
    {%- assign cta_image = 'gg-cta-bg.png' | asset_url -%}
  {%- endif -%}
  <div class="gg-cta__bg" style="background-image:url('{{ cta_image }}')"></div>
  <div class="gg-container gg-cta__content">
    {%- assign gg_cta_title = section.settings.title | default: 'YOUR TEAM IS <br> CALLING, YOUR <br> OUTFIT IS WAITING' -%}
    {%- assign gg_cta_serif = section.settings.serif | default: 'Wear it like <br> you mean it.' -%}
    <h2 class="gg-cta__title">{% render 'gg-breaks', text: gg_cta_title, class: 'gg-cta__title-line' %}</h2>
    <div class="gg-cta__row">
      <p class="gg-cta__serif">{% render 'gg-breaks', text: gg_cta_serif, class: 'gg-cta__serif-line' %}</p>
      <div class="gg-cta__actions">
        {%- if section.settings.pr_label != blank -%}
          <a class="gg-btn gg-btn--orange gg-btn--serif" href="{{ section.settings.pr_link | default: routes.collections_url }}"{% render 'gg-link-attrs', url: section.settings.pr_link %}>{{ section.settings.pr_label }}</a>
        {%- endif -%}
      </div>
      <p class="gg-cta__desc">{{ section.settings.subtext | default: 'Discover college fan staples and statement styles designed to keep your school part of your everyday wardrobe.' }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "G/G CTA Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "title", "label": "Title", "default": "YOUR TEAM IS <br> CALLING, YOUR <br> OUTFIT IS WAITING" },
    { "type": "text", "id": "serif", "label": "Serif line", "default": "Wear it like <br> you mean it." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Discover college fan staples and statement styles designed to keep your school part of your everyday wardrobe." },
    { "type": "text", "id": "pr_label", "label": "Primary label", "default": "Shop g/g on Amazon" },
    { "type": "url", "id": "pr_link", "label": "Primary link" }
  ],
  "presets": [{ "name": "G/G CTA Banner" }]
}
{% endschema %}
{% comment %}
  Renders WishlistSuite SDK heart button for product cards.

  Accepts:
  - product: {Object} Shopify Product Liquid object (required)
  - card_product: {Object} Fallback for Dawn product card snippet
  - class: {String} Extra classes (optional, e.g. 'gg-card__heart')
  - style_mode: {String} 'badge' (white circular badge for standard product cards) or 'icon' (naked icon for custom card tops)

  Usage:
  {% render 'wls-card-heart', product: card_product, style_mode: 'badge' %}
  {% render 'wls-card-heart', product: product, class: 'gg-card__heart' %}
{% endcomment %}

{%- liquid
  assign target_product = product
  if target_product == blank
    assign target_product = card_product
  endif
-%}

{%- if target_product != blank and target_product.id != blank -%}
  {%- liquid
    assign wls_variant = target_product.selected_or_first_available_variant
    assign wls_img_url = target_product.featured_image | image_url: width: 300
    if wls_img_url == blank and target_product.featured_media != blank
      assign wls_img_url = target_product.featured_media | image_url: width: 300
    endif
  -%}
  <button
    type="button"
    class="wls-heart{% if class %} {{ class }}{% endif %}{% if style_mode == 'badge' %} wls-heart--badge{% endif %}"
    data-id="{{ target_product.id }}"
    data-variant="{{ wls_variant.id }}"
    data-handle="{{ target_product.handle }}"
    data-title="{{ target_product.title | escape }}"
    data-image="{{ wls_img_url }}"
    aria-label="Add to wishlist"
    title="Add to wishlist"
  >
    <svg
      class="gg-card__heart-svg wls-heart__svg"
      width="29"
      height="29"
      viewBox="0 0 29 29"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <path
        class="wls-heart__path-outline"

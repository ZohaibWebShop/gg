{%- comment -%}
  Renders a product's store logo from the `custom.store_logo` metafield,
  falling back to the hardcoded g/g mark when the metafield (or the
  product) is missing.

  Usage: {% render 'gg-sports-logo', product: product %}
{%- endcomment -%}

{%- assign store_logo = product.metafields.custom.store_logo.value -%}

{%- if store_logo != blank -%}
  {%- assign store_logo_url = store_logo | image_url: width: 300 -%}
  {%- if store_logo_url == blank -%}
    {%- assign store_logo_url = store_logo -%}
  {%- endif -%}
  <img
    src="{{ store_logo_url }}"
    alt="{{ store_logo.alt | default: product.title | escape }}"
    loading="lazy"
    width="150"
    height="32"
  >
{%- else -%}
  <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="15" fill="rgba(255,255,255,0.85)"/><path d="M16 6 5 24h6l5-10 5 10h6L16 6Z" fill="#0C3054"/></svg>
{%- endif -%}

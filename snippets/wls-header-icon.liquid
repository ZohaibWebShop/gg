{% comment %}
  WishlistSuite SDK — Header Wishlist Heart Icon with Live Count Badge.
  Renders a heart icon that opens the WishlistSuite drawer when the app's
  display mode is set to "Drawer" (otherwise links to the wishlist page),
  with a count badge that updates in real-time on every add/remove.

  SDK Reference:
  - wls.getUserCount()          → Promise<number> (total wishlist items)
  - wls.on('change', fn)        → re-count on add/remove
  - wls.on('count-update', fn)  → direct count broadcast
  - window.WishlistDrawer.open() → opens the built-in wishlist drawer

  Usage: {% render 'wls-header-icon' %}
{% endcomment %}

{%- liquid
  assign wls_header_enabled = false
-%}
{%- if wls_header_enabled -%}
<a href="{{ pages['wishlistsuite-wishlist'].url | default: '/pages/wishlistsuite-wishlist' }}" class="wls-header-icon" aria-label="Wishlist" data-wls-header-link>
  <svg viewBox="0 0 29 29" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <path d="M23.5882 5.84989C22.3478 4.60635 20.7037 3.84736 18.9527 3.71003C17.2018 3.5727 15.4594 4.06608 14.0404 5.10104C12.5517 3.99373 10.6987 3.49163 8.85456 3.69584C7.01045 3.90004 5.31221 4.7954 4.10181 6.20159C2.89141 7.60779 2.25878 9.42037 2.33129 11.2743C2.40381 13.1283 3.1761 14.8859 4.49264 16.1933L11.7588 23.4711C12.3672 24.0699 13.1867 24.4055 14.0404 24.4055C14.8941 24.4055 15.7136 24.0699 16.322 23.4711L23.5882 16.1933C24.9543 14.8188 25.7211 12.9595 25.7211 11.0216C25.7211 9.08363 24.9543 7.2244 23.5882 5.84989ZM21.9384 14.5786L14.6722 21.8447C14.5896 21.9282 14.4911 21.9945 14.3827 22.0397C14.2742 22.0849 14.1579 22.1082 14.0404 22.1082C13.9229 22.1082 13.8066 22.0849 13.6981 22.0397C13.5897 21.9945 13.4912 21.9282 13.4086 21.8447L6.14244 14.5435C5.22482 13.6055 4.71099 12.3455 4.71099 11.0333C4.71099 9.7211 5.22482 8.46107 6.14244 7.52308C7.07751 6.59989 8.33862 6.08223 9.65264 6.08223C10.9667 6.08223 12.2278 6.59989 13.1628 7.52308C13.2716 7.63275 13.401 7.7198 13.5436 7.7792C13.6862 7.8386 13.8391 7.86919 13.9936 7.86919C14.1481 7.86919 14.301 7.8386 14.4436 7.7792C14.5862 7.7198 14.7156 7.63275 14.8243 7.52308C15.7594 6.59989 17.0205 6.08223 18.3345 6.08223C19.6486 6.08223 20.9097 6.59989 21.8448 7.52308C22.775 8.44878 23.3057 9.70197 23.3232 11.0142C23.3407 12.3264 22.8436 13.5933 21.9384 14.5435V14.5786Z" fill="currentColor"/>
  </svg>
  <span class="wls-header-count" data-wls-header-count hidden>0</span>
</a>

<script>
if (typeof window.__wlsHeaderIconInitialized === 'undefined') {
  window.__wlsHeaderIconInitialized = true;
  (function () {
    function paintAll(n) {
      n = Number(n) || 0;
      var badges = document.querySelectorAll('[data-wls-header-count]');
      badges.forEach(function (badge) {
        badge.textContent = n;
        badge.hidden = n <= 0;
      });
    }

    /* Instant paint from localStorage cache (zero-flicker) */
    try {
      var cached = JSON.parse(localStorage.getItem('wishlistVariantIds') || '[]');
      if (Array.isArray(cached) && cached.length > 0) {
        paintAll(cached.length);
      }
    } catch (e) { /* ignore */ }

    window.WishlistCallbacks = window.WishlistCallbacks || [];
    window.WishlistCallbacks.push(function (wls) {
      /* Link all header icons to the merchant's wishlist page */
      var base = (window.WishlistGlobal && window.WishlistGlobal.wlsProxyBase) || '/apps/wlsp';
      var href = (window.WishlistGlobal && window.WishlistGlobal.wishlistPageUrl) || (base + '/list');
      var links = document.querySelectorAll('[data-wls-header-link]');
      links.forEach(function (link) { link.href = href; });

      /* 1) Initial count from server */
      if (typeof wls.getUserCount === 'function') {
        wls.getUserCount().then(paintAll);
      }

      /* 2) Re-count on every add/remove */
      wls.on('change', function () {
        if (typeof wls.getUserCount === 'function') {
          wls.getUserCount().then(paintAll);
        }
      });

      /* 3) Direct count broadcast from the app */
      wls.on('count-update', function (d) {
        paintAll(d && d.count);
      });
    });

    /* Open the built-in WishlistSuite drawer on click when the app is set to
       "Display mode: Drawer". Falls back to the wishlist page link otherwise. */
    document.addEventListener('click', function (e) {
      var link = e.target.closest('[data-wls-header-link]');
      if (!link) return;

      var config = window.WishlistGlobal && window.WishlistGlobal.config;
      if (
        config &&
        config.displayMode === 'drawer' &&
        window.WishlistDrawer &&
        typeof window.WishlistDrawer.open === 'function'
      ) {
        e.preventDefault();

        /* Close the theme's mobile menu first so the drawer is visible */
        if (document.body.classList.contains('gg-menu-open')) {
          document.body.classList.remove('gg-menu-open');
          var burger = document.querySelector('.gg-header__burger');
          if (burger) burger.setAttribute('aria-expanded', 'false');
        }

        window.WishlistDrawer.open();
      }
    });
  })();
}
</script>
{%- endif -%}

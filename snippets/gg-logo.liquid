{%- comment -%}
  Reusable G/G header logo. Uses the schema logo image when set,
  otherwise falls back to the brand name + orange mark.
{%- endcomment -%}
<a class="gg-header__logo" href="{{ routes.root_url }}">
  {%- if settings.logo != blank -%}
    {%- assign gg_logo_alt = settings.logo.alt | default: shop.name | escape -%}
    {%- assign gg_logo_width = settings.logo_width | default: 100 -%}
    {%- assign gg_logo_height = gg_logo_width | divided_by: settings.logo.aspect_ratio -%}
    {%- if preload == false -%}
      {{
        settings.logo
        | image_url: width: 600
        | image_tag:
          class: 'gg-header__logo-img',
          widths: '50, 100, 120, 160, 200, 240, 300, 400, 500, 600',
          height: gg_logo_height,
          width: gg_logo_width,
          alt: gg_logo_alt
      }}
    {%- else -%}
      {{
        settings.logo
        | image_url: width: 600
        | image_tag:
          class: 'gg-header__logo-img',
          widths: '50, 100, 120, 160, 200, 240, 300, 400, 500, 600',
          height: gg_logo_height,
          width: gg_logo_width,
          alt: gg_logo_alt,
          preload: true
      }}
    {%- endif -%}
  {%- else -%}
    <svg class="gg-logo-mark" viewBox="0 0 34 34" fill="none" aria-hidden="true">
      <path d="M17 2 5 23h9l3-6m0 6 3 6h9L17 2Z" fill="currentColor" opacity="0.9"/>
    </svg>
    {{ settings.gg_brand_name | default: 'g/g' }}
  {%- endif -%}
</a>
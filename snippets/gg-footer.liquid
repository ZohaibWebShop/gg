<footer class="gg-footer">
  <div class="gg-container">
    <div class="gg-footer__top">
      <div class="gg-footer__brand">
        <a href="{{ routes.root_url }}">
          {%- if settings.logo != blank -%}
            {%- assign gg_logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign gg_logo_width = settings.logo_width | default: 100 -%}
            {%- assign gg_logo_height = gg_logo_width | divided_by: settings.logo.aspect_ratio -%}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'gg-footer__logo-img',
                widths: '50, 100, 120, 160, 200, 240, 300, 400, 500, 600',
                height: gg_logo_height,
                width: gg_logo_width,
                alt: gg_logo_alt
            }}
          {%- else -%}
            <svg class="gg-logo-mark" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true" style="vertical-align:-8px;margin-right:4px;">
              <path d="M20 2 6 28h11l3-6m0 6 3 6h11L20 2Z" fill="#F26728"/>
            </svg>
            {{ settings.gg_brand_name | default: 'g/g' }}
          {%- endif -%}
        </a>
        {%- liquid
          assign gg_has_socials = false
          if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_tiktok_link != blank or settings.social_pinterest_link != blank
            assign gg_has_socials = true
          endif
        -%}
        {%- if gg_has_socials -%}
          <div class="gg-footer__socials">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}"{% render 'gg-link-attrs', url: settings.social_instagram_link %} aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link }}"{% render 'gg-link-attrs', url: settings.social_facebook_link %} aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V5h-3c-2.2 0-4 1.8-4 4v2H7v3h3v7h3v-7h3l1-3h-4V9c0-.6.4-1 1-1Z"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <a href="{{ settings.social_tiktok_link }}"{% render 'gg-link-attrs', url: settings.social_tiktok_link %} aria-label="TikTok">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 3c.3 2.2 1.7 3.9 4 4.3v3c-1.6 0-3-.5-4-1.3v6.7C16 18.4 13.6 21 10.3 21 7.4 21 5 19 5 16.4c0-2.7 2.5-4.7 5.3-4.4v3c-.6-.2-1.2-.1-1.6.3-.4.4-.6 1-.2 1.5.3.4 1 .6 1.5.2.6-.4.9-1.1.9-1.9V3h4.1Z"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <a href="{{ settings.social_pinterest_link }}"{% render 'gg-link-attrs', url: settings.social_pinterest_link %} aria-label="Pinterest">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3a9 9 0 0 0-3.4 17.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1a4.4 4.4 0 0 0-4.6 4.4c0 .8.3 1.7.7 2.2l-.3 1.1c-.1.4-.3.5-.6.3-1.2-.6-2-2.3-2-3.8A6.5 6.5 0 0 1 12 5.4a5.4 5.4 0 0 1 5.8 5.4c0 3.2-2 5.8-4.8 5.8-.9 0-1.8-.5-2.1-1.1l-.6 2.2c-.2.8-.8 1.8-1.2 2.4A9 9 0 1 0 12 3Z"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div>
        {%- assign gg_fm = linklists[settings.gg_menu_catalog] -%}
        {%- if gg_fm.links.size > 0 -%}
          <h4 class="gg-footer__column-header">{{ settings.gg_menu_catalog_title | default: gg_fm.title | default: 'Catalog' }}</h4>
          <ul class="gg-footer__links">
            {%- for link in gg_fm.links -%}
              <li><a href="{{ link.url }}"{% render 'gg-link-attrs', url: link.url %}>{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div>
        {%- assign gg_fcustomers = linklists[settings.gg_menu_customers] -%}
        {%- if gg_fcustomers.links.size > 0 -%}
          <h4 class="gg-footer__column-header">{{ settings.gg_menu_customers_title | default: gg_fcustomers.title | default: 'Customers' }}</h4>
          <ul class="gg-footer__links">
            {%- for link in gg_fcustomers.links -%}
              <li><a href="{{ link.url }}"{% render 'gg-link-attrs', url: link.url %}>{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div>
        {%- assign gg_fbrand = linklists[settings.gg_menu_brand] -%}
        {%- if gg_fbrand.links.size > 0 -%}
          <h4 class="gg-footer__column-header">{{ settings.gg_menu_brand_title | default: gg_fbrand.title | default: 'Brand' }}</h4>
          <ul class="gg-footer__links">
            {%- for link in gg_fbrand.links -%}
              <li><a href="{{ link.url }}"{% render 'gg-link-attrs', url: link.url %}>{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    <div class="gg-footer__bottom{% unless settings.gg_newsletter_enable %} gg-footer__bottom--single{% endunless %}">
      <div>
        {% comment %}
        <ul class="gg-footer__legal">
          <li><a href="{{ routes.root_url }}">Terms of Service</a></li>
          <li><a href="{{ routes.root_url }}">Cookie Policy</a></li>
          <li><a href="{{ routes.root_url }}">Privacy Policy</a></li>
        </ul>
        {% endcomment %}
        {%- if shop.languages.size > 1 -%}
          {%- assign gg_locale_name = request.locale.endonym_name | default: 'English' -%}
          {%- form 'localization', id: 'FooterLanguageForm', class: 'gg-footer__lang' -%}
            <label class="visually-hidden" for="FooterLanguageSelect">Language</label>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.2 3.9 5.4 3.9 9S14.5 18.8 12 21m0-18c-2.5 2.2-3.9 5.4-3.9 9s1.4 6.8 3.9 9"/></svg>
            <select id="FooterLanguageSelect" class="gg-footer__lang-select" name="locale_code" title="{{ gg_locale_name }}" data-gg-lang-select>
              {%- for language in shop.languages -%}
                <option value="{{ language.iso_code }}" title="{{ language.endonym_name }}"{% if language.iso_code == request.locale.iso_code %} selected{% endif %}>{{ language.iso_code | slice: 0, 2 | capitalize }}</option>
              {%- endfor -%}
            </select>
            <noscript><button type="submit" class="gg-footer__lang-go">Go</button></noscript>
          {%- endform -%}
        {%- endif -%}
      </div>

      {%- if settings.gg_newsletter_enable -%}
        <div>
          <h3 class="gg-footer__news-title">{{ settings.gg_news_heading | default: 'Be the first to know about our<br>special offers' }}</h3>

          {%- form 'customer', id: 'GGFooterContactForm', class: 'gg-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            <div class="gg-footer__field">
              <label class="visually-hidden" for="GGFooterFirstName">Your Name</label>
              <input
                id="GGFooterFirstName"
                type="text"
                name="contact[first_name]"
                value="{{ form.first_name | escape }}"
                placeholder="Your Name"
                autocomplete="given-name"
              >
            </div>

            <div class="gg-footer__field">
              <label class="visually-hidden" for="GGFooterEmail">{{ 'newsletter.label' | t }}</label>
              <input
                id="GGFooterEmail"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                placeholder="login@email.com"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                aria-required="true"
                required
                {% if form.errors -%}
                  aria-invalid="true"
                  aria-describedby="GGFooterFormErrors"
                {%- endif %}
              >
            </div>

            <button type="submit" class="gg-footer__submit" name="commit">
              {{ settings.gg_news_btn | default: 'Sign up' }}
            </button>

            <div class="gg-footer__consent">
              <input
                type="checkbox"
                id="GGFooterPrivacy"
                name="contact[accepts_marketing]"
                value="1"
                required
              >
              <label for="GGFooterPrivacy">I agree to the <a class="gg-footer__consent-link" href="{{ shop.policies.privacy_policy.url | default: '/policies/privacy-policy' }}"{% render 'gg-link-attrs', url: shop.policies.privacy_policy.url %}>privacy policy</a></label>
            </div>

            {%- if form.errors -%}
              <div class="gg-footer__form-message gg-footer__form-message--error" id="GGFooterFormErrors" role="alert">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {%- for field in form.errors.messages -%}
                  <span>{{ field[0] | capitalize }} {{ field[1] }}</span>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <p
                class="gg-footer__form-message gg-footer__form-message--success"
                id="GGFooterFormSuccess"
                role="status"
                tabindex="-1"
                autofocus
              >
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{- 'newsletter.success' | t }}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>